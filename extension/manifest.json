{
  "manifest_version": 3,
  "name": "Ctrl+A",
  "version": "1.0.0",
  "description": "Grab the whole page as clean Markdown. Press Ctrl+A, preview, drop the noise you don't want, then copy or download .md.",
  "permissions": ["scripting", "activeTab"],
  "action": {
    "default_title": "Ctrl+A — page to Markdown",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
